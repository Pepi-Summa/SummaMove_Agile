<Window x:Class="SummaMove.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SummaMove"
        mc:Ignorable="d"
        Title="Inloggen"
        Height="1280"
        Width="720"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- Achtergrond -->
        <Image Source="/Sport Wallpaper.jpg"
               Stretch="UniformToFill"/>

        <!-- Overlay -->
        <Rectangle Fill="#8A9395"
                   Opacity="0.8"/>

        <!-- Content -->
        <StackPanel
            VerticalAlignment="Center"
            Margin="70">

            <!-- Logo -->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,0,0,50">

                <Image Source="/Summa_Move2_transparant.png" Height="300"/>

            </StackPanel>

            <!-- Titel -->
            <TextBlock
                Text="Log in"
                FontSize="32"
                Foreground="White"
                HorizontalAlignment="Center"
                Margin="0,0,0,40"/>

            <!-- Email -->
            <TextBlock
                Text="Email"
                FontSize="20"
                Foreground="White"
                Margin="0,0,0,10"/>
            <TextBox
                Height="50"
                FontSize="18"
                Background="White"
                Foreground="Black"
                BorderThickness="0"
                Margin="0,0,0,25"/>

            <!-- Wachtwoord -->
            <TextBlock
                Text="Wachtwoord"
                FontSize="20"
                Foreground="White"
                Margin="0,0,0,10"/>

            <PasswordBox
                Height="50"
                FontSize="18"
                Background="White"
                Foreground="Black"
                BorderThickness="0"
                Margin="0,0,0,40"/>

            <!-- Login knop -->
            <Button
                Content="Inloggen"
                Height="70"
                Background="#3B00B9"
                Foreground="White"
                FontSize="28"
                FontWeight="Bold"
                BorderThickness="0"
                Cursor="Hand"
                Margin="0,0,0,20"/>

            <!-- Register link -->
            <Button Content="Nog geen account?"
        Background="Transparent"
        BorderThickness="0"
        Foreground="White"
        FontSize="18"
        HorizontalAlignment="Center"
        Cursor="Hand"
        Click="RegisterButton_Click"/>

        </StackPanel>

    </Grid>

</Window>