<Window x:Class="SummaMove.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SummaMove"
        mc:Ignorable="d"
        Title="Registreren"
        Height="820"
        Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>

        <!-- Achtergrond (fixed) -->
        <Image Source="/Sport Wallpaper.jpg"
               Stretch="UniformToFill"/>

        <!-- Overlay (fixed) -->
        <Rectangle Fill="#B3FFFFFF"/>

        <!-- Scrollbare content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled">

            <Grid>

                <StackPanel Width="420"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,80,0,40">

                    <!-- Logo -->
                    <Image Source="/Summa_Move2_transparant.png"
                           Width="220"
                           Height="300"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                    <!-- Titel -->
                    <TextBlock Text="Welkom!"
                               FontSize="32"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,40"/>

                    <!-- Gebruikersnaam -->
                    <TextBlock Text="Gebruikersnaam"
                               FontSize="18"
                               Margin="0,0,0,8"/>

                    <TextBox Height="50"
                             FontSize="18"
                             Background="White"
                             BorderBrush="#DDDDDD"
                             Margin="0,0,0,25"/>

                    <!-- Email -->
                    <TextBlock Text="Email"
                               FontSize="18"
                               Margin="0,0,0,8"/>

                    <TextBox Height="50"
                             FontSize="18"
                             Background="White"
                             BorderBrush="#DDDDDD"
                             Margin="0,0,0,25"/>

                    <!-- Wachtwoord -->
                    <TextBlock Text="Wachtwoord"
                               FontSize="18"
                               Margin="0,0,0,8"/>

                    <PasswordBox Height="50"
                                 FontSize="18"
                                 Background="White"
                                 BorderBrush="#DDDDDD"
                                 Margin="0,0,0,25"/>

                    <!-- Bevestigen -->
                    <TextBlock Text="Bevestig Wachtwoord"
                               FontSize="18"
                               Margin="0,0,0,8"/>

                    <PasswordBox Height="50"
                                 FontSize="18"
                                 Background="White"
                                 BorderBrush="#DDDDDD"
                                 Margin="0,0,0,40"/>

                    <!-- Registreren knop -->
                    <Button Content="Maak account"
                            Height="70"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="White"
                            Background="#3D18B8"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,0,15"/>

                    <!-- Login knop -->
                    <Button Content="Ik heb al een account"
                            Click="Button_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="16"
                            HorizontalAlignment="Left"
                            Cursor="Hand"/>

                </StackPanel>

            </Grid>

        </ScrollViewer>

    </Grid>
</Window>