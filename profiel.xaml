<Window x:Class="SummaMove.profiel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SummaMove"
        mc:Ignorable="d"
        Title="Profiel"
        Height="700"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Achtergrond -->
        <Rectangle Fill="#EDEDED"
                   Grid.RowSpan="2"/>

        <!-- Titel -->
        <TextBlock Text="Profiel"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="20,20,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Grid.Row="0"/>

        <!-- PROFIEL CARD -->
        <Border Width="320"
                Height="480"
                Background="#B7BCC3"
                CornerRadius="20"
                Padding="20"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Grid.Row="0">

            <StackPanel HorizontalAlignment="Center">

                <!-- Logo -->
                <Image Source="Summa_Move2_transparant.png"
                       Height="50"
                       Width="120"
                       Stretch="Uniform"
                       Margin="0,0,0,10"/>

                <!-- Avatar -->
                <Grid HorizontalAlignment="Center" Margin="0,10">
                    <Ellipse Width="90" Height="90" Fill="White"/>
                    <Image Source="/avatar.webp"
                           Width="70"
                           Height="70"/>
                </Grid>

                <!-- Naam -->
                <TextBlock Text="Pepi-Summa"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,20"/>

                <!-- Bio -->
                <TextBlock Text="Bio"
                           FontSize="14"
                           HorizontalAlignment="Left"/>

                <TextBox Height="80"
                         Background="#D9D9D9"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         Margin="0,5,0,20"/>

                <!-- Cosmetics knop -->
                <Button Content="Cosmetics"
                        Height="35"
                        Width="140"
                        Background="#FF2D8C"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Margin="0,0,0,20"/>

                <!-- Email -->
                <TextBlock Text="Email:"
                           FontSize="14"
                           HorizontalAlignment="Left"/>

                <TextBox Text="pepi@mail.com"
                         Background="#D9D9D9"
                         BorderThickness="0"
                         Margin="0,5,0,0"/>

            </StackPanel>

        </Border>

        <!-- NAVIGATION MENU (onderaan) -->
        <local:NavigationMenu Grid.Row="1"/>

    </Grid>

</Window>