<Window x:Class="SummaMove.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SummaMove"
        mc:Ignorable="d"
        Title="Registreren"
        Height="1280"
        Width="720"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- Achtergrond afbeelding -->
        <Image Source="/Sport Wallpaper.jpg"
               Stretch="UniformToFill"/>

        <!-- Overlay -->
        <Rectangle Fill="#8A9395"
                   Opacity="0.8"/>

        <!-- Hoofdcontainer -->
        <StackPanel
            VerticalAlignment="Top"
            Margin="70,80,70,0">

            <!-- Logo -->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,0,0,40">

                <Image Source="/Summa_Move2_transparant.png" Height="300"/>
            </StackPanel>

            <!-- Welkom -->
            <TextBlock
                Text="Welkom!"
                FontSize="32"
                Foreground="White"
                HorizontalAlignment="Center"
                Margin="0,0,0,40" />

            <!-- Gebruikersnaam -->
            <TextBlock
                Text="Gebruikersnaam"
                FontSize="20"
                Foreground="White"
                Margin="0,0,0,10" />

            <TextBox
                Height="50"
                FontSize="18"
                Background="White"
                Foreground="Black"
                BorderThickness="0"
                Margin="0,0,0,25" />

            <!-- Email -->
            <TextBlock
                Text="Email"
                FontSize="20"
                Foreground="White"
                Margin="0,0,0,10" />

            <TextBox
                Height="50"
                FontSize="18"
                Background="White"
                Foreground="Black"
                BorderThickness="0"
                Margin="0,0,0,25" />

            <!-- Wachtwoord -->
            <TextBlock
                Text="Wachtwoord"
                FontSize="20"
                Foreground="White"
                Margin="0,0,0,10" />

            <PasswordBox
                Height="50"
                FontSize="18"
                Background="White"
                Foreground="Black"
                BorderThickness="0"
                Margin="0,0,0,25" />

            <!-- Bevestig wachtwoord -->
            <TextBlock
                Text="Bevestig Wachtwoord"
                FontSize="20"
                Foreground="White"
                Margin="0,0,0,10" />

            <PasswordBox
                Height="50"
                FontSize="18"
                Background="White"
                Foreground="Black"
                BorderThickness="0"
                Margin="0,0,0,40" />

            <!-- Account knop -->
            <Button
                Content="Maak account"
                Height="70"
                Background="#3B00B9"
                Foreground="White"
                FontSize="28"
                FontWeight="Bold"
                BorderThickness="0"
                Cursor="Hand"
                Margin="0,0,0,20" Click="Button_Click" />

            <!-- Login tekst -->
            <Button Content="Ik heb al een account"
        FontSize="18"
        Foreground="White"
        Background="Transparent"
        BorderThickness="0"
        HorizontalAlignment="Left"
        Cursor="Hand"
        Click="LoginButton_Click"/>
        </StackPanel>

    </Grid>

</Window>