<Window x:Class="SummaMove.Homepagina"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Homepagina"
        Height="1280"
        Width="720"
        WindowStartupLocation="CenterScreen"
        xmlns:local="clr-namespace:SummaMove">
    

    <Grid Background="#BCBEC4">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="650"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Background="#D9D9D9">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Source="Summa_Move2_transparant.png"
                   Width="150"
                   Margin="15,0,0,0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="0,10,15,10">

                <StackPanel Margin="0,0,10,0">

                    <TextBlock x:Name="UsernameText"
                               Text="Daan"
                               FontSize="16"
                               HorizontalAlignment="Right"/>

                    <Border Background="White"
                            Padding="8,4"
                            Margin="0,4,0,0">

                        <TextBlock x:Name="PointsText"
                                   Text="1200 Punten"/>

                    </Border>

                </StackPanel>

                <Ellipse Width="40"
                         Height="40"
                         Fill="White"/>

            </StackPanel>

        </Grid>

        <!-- CHALLENGES -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="10">

            <StackPanel>

                <TextBlock Text="Beschikbare Challenges"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <ItemsControl x:Name="ChallengesList">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Background="#6440B8"
                                    CornerRadius="25"
                                    Margin="0,0,0,15">

                                <Grid Margin="20">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Titel -->

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Name}"
                                               Foreground="White"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,20"/>

                                    <!-- Moeilijkheid + Beloning -->

                                    <Grid Grid.Row="1">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock Text="Moeilijkheid"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>

                                            <Border Background="#FF3E9F"
                                                    CornerRadius="20"
                                                    Height="40"
                                                    Margin="8">

                                                <TextBlock Text="{Binding Difficulty}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                            </Border>

                                        </StackPanel>

                                        <StackPanel Grid.Column="1">

                                            <TextBlock Text="Beloning"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>

                                            <Border Background="#FF3E9F"
                                                    CornerRadius="20"
                                                    Height="40"
                                                    Margin="8">

                                                <TextBlock Text="{Binding PointReward}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                            </Border>

                                        </StackPanel>

                                    </Grid>

                                    <!-- Beschrijving -->

                                    <StackPanel Grid.Row="2"
                                                Margin="0,15,0,0">

                                        <TextBlock Text="Taak"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,10"/>

                                        <Border Background="#FF3E9F"
                                                CornerRadius="15"
                                                Padding="15">

                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap"/>

                                        </Border>

                                    </StackPanel>

                                    <!-- Button -->

                                    <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0">

                                        <Button Content="Start Challenge"
                                            Width="160"
                                            Height="40"
                                            Margin="5"
                                            Tag="{Binding Id}"
                                            Click="StartChallenge_Click"/>

                                        <Button Content="Voltooi Challenge"
                                             Width="160"
                                             Height="40"
                                             Margin="5"
                                             Tag="{Binding Id}"
                                             Click="CompleteChallenge_Click"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

        <!-- MELDINGEN -->

        <StackPanel Grid.Row="2"
                    Margin="0,20,0,40">

            <TextBlock Text="Meldingen:"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <ListBox x:Name="NotificationsList"
                     Width="350"
                     HorizontalAlignment="Center"
                     Height="200"/>

        </StackPanel>
        <local:NavigationMenu Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom"/>
    </Grid>

</Window>