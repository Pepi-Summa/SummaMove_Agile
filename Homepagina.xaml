<Window x:Class="SummaMove.Homepagina"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SummaMove"
        Title="Homepagina"
        Height="1280"
        Width="720"
        WindowStartupLocation="CenterScreen">

    <!-- LIGHT BACKGROUND -->
    <Grid Background="#F2F4F8">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER (was dark → now light) -->
        <Grid Grid.Row="0" Background="#FFFFFF">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Source="Summa_Move2_transparant.png"
                   Width="150"
                   Margin="15,0,0,0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"/>

            <!-- PROFILE -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="0,10,15,10">

                <StackPanel Margin="0,0,10,0">

                    <TextBlock x:Name="UsernameText"
                               Text="Daan"
                               Foreground="#111111"
                               FontSize="16"
                               HorizontalAlignment="Right"/>

                    <Border Background="#E6EAF0"
                            Padding="8,4"
                            Margin="0,4,0,0">

                        <TextBlock x:Name="PointsText"
                                   Text="1200 Punten"
                                   Foreground="#111111"/>
                    </Border>

                </StackPanel>

                <Ellipse Width="40"
                         Height="40"
                         Fill="#CCCCCC"/>
            </StackPanel>

        </Grid>

        <!-- CHALLENGES -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="10">

            <StackPanel>

                <TextBlock Text="Beschikbare Challenges"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#111111"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <ItemsControl x:Name="ChallengesList">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <!-- CARD (was dark blue → now white) -->
                            <Border Background="#FFFFFF"
                                    BorderBrush="#D6DCE6"
                                    BorderThickness="1"
                                    CornerRadius="25"
                                    Margin="0,0,0,15">

                                <Grid Margin="20">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- TITLE -->
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Name}"
                                               Foreground="#111111"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,20"/>

                                    <!-- DIFFICULTY + REWARD -->
                                    <Grid Grid.Row="1">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock Text="Moeilijkheid"
                                                       Foreground="#333333"
                                                       HorizontalAlignment="Center"/>

                                            <Border Background="#E6EAF0"
                                                    CornerRadius="20"
                                                    Height="40"
                                                    Margin="8">

                                                <TextBlock Text="{Binding Difficulty}"
                                                           Foreground="#111111"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                        </StackPanel>

                                        <StackPanel Grid.Column="1">

                                            <TextBlock Text="Beloning"
                                                       Foreground="#333333"
                                                       HorizontalAlignment="Center"/>

                                            <Border Background="#E6EAF0"
                                                    CornerRadius="20"
                                                    Height="40"
                                                    Margin="8">

                                                <TextBlock Text="{Binding PointReward}"
                                                           Foreground="#111111"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                        </StackPanel>

                                    </Grid>

                                    <!-- DESCRIPTION -->
                                    <StackPanel Grid.Row="2"
                                                Margin="0,15,0,0">

                                        <TextBlock Text="Taak"
                                                   Foreground="#333333"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,10"/>

                                        <Border Background="#F0F2F6"
                                                CornerRadius="15"
                                                Padding="15">

                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="#111111"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                    </StackPanel>

                                    <!-- BUTTONS -->
                                    <StackPanel Grid.Row="3"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,20,0,0">

                                        <Button Content="Start Challenge"
                                                Width="160"
                                                Height="40"
                                                Margin="5"
                                                Tag="{Binding Id}"
                                                Click="StartChallenge_Click"
                                                Background="#FFFFFF"
                                                Foreground="#111111"
                                                BorderBrush="#C9D1DD"/>

                                        <Button Content="Voltooi Challenge"
                                                Width="160"
                                                Height="40"
                                                Margin="5"
                                                Tag="{Binding Id}"
                                                Click="CompleteChallenge_Click"
                                                Background="#FFFFFF"
                                                Foreground="#111111"
                                                BorderBrush="#C9D1DD"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

        <!-- NAVIGATION -->
        <local:NavigationMenu Grid.Row="2"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom"/>

    </Grid>

</Window>