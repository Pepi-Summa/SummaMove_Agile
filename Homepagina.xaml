<Window x:Class="SummaMove.Homepagina"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SummaMove"
        mc:Ignorable="d"
        Title="Homepagina"
        Height="1280"
        Width="720"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#BCBEC4">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="320"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Background="#D9D9D9">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <Image Source="/Summa_Move2_transparant.png"
                   Width="150"
                   Margin="15,0,0,0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"/>

            <!-- Profiel -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="0,10,15,10">

                <StackPanel Margin="0,0,10,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding ProfielNaam}"
                               FontSize="16"
                               HorizontalAlignment="Right"/>

                    <Border Background="White"
                            Padding="8,4"
                            Margin="0,4,0,0">

                        <TextBlock Text="{Binding Punten}" />

                    </Border>

                </StackPanel>

                <!-- Tijdelijke profielfoto -->
                <Ellipse Width="40"
                         Height="40"
                         Fill="White"/>

            </StackPanel>

        </Grid>

        <!-- CHALLENGE -->
        <Border Grid.Row="1"
                Margin="10"
                CornerRadius="25"
                Background="#6440B8">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Actieve Challenge"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- Moeilijkheid -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Moeilijkheid"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>

                        <Border Background="#FF3E9F"
                                CornerRadius="20"
                                Height="40"
                                Margin="8">

                            <TextBlock Text="{Binding ActieveChallenge.Moeilijkheid}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>

                        </Border>

                    </StackPanel>

                    <!-- Beloning -->
                    <StackPanel Grid.Column="1">

                        <TextBlock Text="Beloning"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>

                        <Border Background="#FF3E9F"
                                CornerRadius="20"
                                Height="40"
                                Margin="8">

                            <TextBlock Text="{Binding ActieveChallenge.Beloning}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>

                        </Border>

                    </StackPanel>

                </Grid>

                <!-- Taak -->
                <StackPanel Grid.Row="2"
                            Margin="0,20,0,0">

                    <TextBlock Text="Taak"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <Border Background="#FF3E9F"
                            CornerRadius="15"
                            Padding="15"
                            Height="110">

                        <TextBlock Text="{Binding ActieveChallenge.Omschrijving}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>

                    </Border>

                </StackPanel>

            </Grid>

        </Border>

        <!-- MELDINGEN -->
        <StackPanel Grid.Row="2"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,120">

            <TextBlock Text="Meldingen:"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <ItemsControl ItemsSource="{Binding Meldingen}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Width="320"
                                Background="#ECECEC"
                                Padding="12"
                                Margin="0,5"
                                HorizontalAlignment="Center">

                            <TextBlock Text="{Binding Bericht}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    </Grid>

</Window>