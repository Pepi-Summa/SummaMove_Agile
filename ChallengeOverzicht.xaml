<Window x:Class="SummaMove.ChallengeOverzicht"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SummaMove"
        
        mc:Ignorable="d"
        Title="ChallengeOverzicht" Height="760" Width="390"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#D9D9D9">

    <Grid>
        <!-- Mobiel scherm -->
        <Border Background="#D9D9D9"
                CornerRadius="25"
                Margin="5">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <!-- CONTENT -->
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Hidden">

                    <StackPanel Margin="12">

                        <!-- Titel -->
                        <TextBlock Text="Challenge-overzicht"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="Gray"
                                   Margin="5"/>

                        <!-- Topbar -->
                        <Grid Margin="5,15">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Logo -->
                            <Image Source="Summa_Move2_transparant.png"
                                           Height="50"
                                            Width="120"
                                            Stretch="Uniform"
                                            VerticalAlignment="Center"/>

                            <!-- Profiel -->
                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Pepi-Summa"
                                           FontSize="12"
                                           HorizontalAlignment="Center"/>

                                <Border Background="White"
                                        Padding="10,5"
                                        CornerRadius="8"
                                        Margin="0,5,0,0">

                                    <TextBlock Text="150 Punten"
                                               FontWeight="Bold"/>
                                </Border>

                            </StackPanel>

                        </Grid>

                        <!-- Challenge Card -->
                        <Border Background="#3C0CA3"
                                CornerRadius="25"
                                Padding="18"
                                Margin="0,10">

                            <StackPanel>

                                <TextBlock Text="Makkelijke Challenge"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Taak"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           Margin="0,18,0,8"
                                           HorizontalAlignment="Center"/>

                                <Border Background="#FF1493"
                                        CornerRadius="18"
                                        Padding="12">

                                    <TextBlock Text="Loop van de Sterrenlaan bushalte naar de Mercuriuslaan bushalte"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <TextBlock Text="Beloning"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           Margin="0,18,0,8"
                                           HorizontalAlignment="Center"/>

                                <Border Background="#FF1493"
                                        Width="120"
                                        CornerRadius="15"
                                        Padding="8"
                                        HorizontalAlignment="Center">

                                    <TextBlock Text="50 Punten"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                </Border>

                            </StackPanel>

                        </Border>

                        <!-- Card 2 -->
                        <Border Background="#3C0CA3"
                                CornerRadius="25"
                                Padding="18"
                                Margin="0,10">

                            <StackPanel>

                                <TextBlock Text="Gemiddelde Challenge"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Taak"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           Margin="0,18,0,8"
                                           HorizontalAlignment="Center"/>

                                <Border Background="#FF1493"
                                        CornerRadius="18"
                                        Padding="12">

                                    <TextBlock Text="Doe 10 Push-ups"
                                               TextAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <TextBlock Text="Beloning"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           Margin="0,18,0,8"
                                           HorizontalAlignment="Center"/>

                                <Border Background="#FF1493"
                                        Width="120"
                                        CornerRadius="15"
                                        Padding="8"
                                        HorizontalAlignment="Center">

                                    <TextBlock Text="100 Punten"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                </Border>

                            </StackPanel>

                        </Border>

                        <!-- Card 3 -->
                        <Border Background="#3C0CA3"
                                CornerRadius="25"
                                Padding="18"
                                Margin="0,10,0,20">

                            <StackPanel>

                                <TextBlock Text="Moeilijke Challenge"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Taak"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           Margin="0,18,0,8"
                                           HorizontalAlignment="Center"/>

                                <Border Background="#FF1493"
                                        CornerRadius="18"
                                        Padding="12">

                                    <TextBlock Text="Loop voor 30 minuten zonder stil te staan"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <TextBlock Text="Beloning"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           Margin="0,18,0,8"
                                           HorizontalAlignment="Center"/>

                                <Border Background="#FF1493"
                                        Width="120"
                                        CornerRadius="15"
                                        Padding="8"
                                        HorizontalAlignment="Center">

                                    <TextBlock Text="150 Punten"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                </Border>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                <local:NavigationMenu Grid.Row="1"/>

            </Grid>

        </Border>
    </Grid>
</Window>
