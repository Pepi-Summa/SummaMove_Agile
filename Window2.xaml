<Window x:Class="SummaMove.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Inloggen"
        Height="1280"
        Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>

        <!-- Achtergrond -->
        <Image Source="/Sport Wallpaper.jpg"
               Stretch="UniformToFill"/>

        <!-- Overlay -->
        <Rectangle Fill="#B3FFFFFF"/>

        <!-- Content -->
        <StackPanel Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,80,0,0">

            <!-- Logo -->
            <Image Source="/Summa_Move2_transparant.png"
                   Width="220"
                   Height="300"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

            <!-- Titel -->
            <TextBlock Text="Welkom terug!"
                       FontSize="32"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Gebruikersnaam / Email -->
            <TextBlock Text="Gebruikersnaam of Email"
                       FontSize="18"
                       Margin="0,0,0,8"/>

            <TextBox Height="50"
                     FontSize="18"
                     Background="White"
                     BorderBrush="#DDDDDD"
                     Margin="0,0,0,25"/>

            <!-- Wachtwoord -->
            <TextBlock Text="Wachtwoord"
                       FontSize="18"
                       Margin="0,0,0,8"/>

            <PasswordBox Height="50"
                         FontSize="18"
                         Background="White"
                         BorderBrush="#DDDDDD"
                         Margin="0,0,0,40"/>

            <!-- Login knop -->
            <Button Content="Inloggen"
                    Height="70"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="White"
                    Background="#3D18B8"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,0,15"/>

            <!-- Registreren -->
            <Button Content="Nog geen account? Registreer"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="16"
                    HorizontalAlignment="Left"
                    Cursor="Hand"/>

        </StackPanel>

    </Grid>
</Window>